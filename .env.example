# There is no password here: you log in with your Financez username and password
# Shared with Financez (CLIENT_SYNC_TOKEN). Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_TOKEN=
# Signs the session cookie. Generate the same way, use a different value.
SECRET_KEY=
# Set to False only for local testing over plain http
COOKIE_SECURE=True
